# Public values: paste these into Vercel > Project > Settings > Environment Variables
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=rupturemap

# Local database provisioning ONLY. Never use NEXT_PUBLIC_ prefix or add to Vercel.
APPWRITE_API_KEY=your_server_api_key_for_initial_setup_only
